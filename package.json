{
  "name": "chiefvoice-crm-backend",
  "version": "1.0.0",
  "description": "ChiefVoice CRM backend — Express API with MySQL data store and S3-compatible call recording storage.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --testPathPatterns=tests/ --forceExit",
    "migrate:channel-credentials": "node scripts/migrate-channel-credentials.js",
    "test:mysql": "MYSQL_INTEGRATION_TESTS=1 jest tests/mysqlIntegration.test.js --runInBand --forceExit",
    "check:deps": "node scripts/check-dependency-lock.js",
    "check:workspace-scope": "node scripts/check-workspace-scope.js",
    "start:callback-scheduler": "node callback-scheduler.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.15.0",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/google-vertexai": "^2.3.2",
    "@opentelemetry/api": "^1.9.1",
    "alawmulaw": "^6.0.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "libphonenumber-js": "^1.13.13",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.47.0",
    "starhealth-quote-cli": "file:./vendor/starhealth-quote-cli",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.17.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.4.5",
    "zod": "^3.25.76",
    "firebase-admin": "^13.5.0",
    "aws-jwt-verify": "^5.1.1",
    "oci-sdk": "^2.141.0",
    "@aws-sdk/client-sqs": "^3.1127.0",
    "@aws-sdk/client-eventbridge": "^3.1127.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
  }
}
