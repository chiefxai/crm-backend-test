# ============================================================
# CRM BACKEND - CURRENT OCI + COGNITO ARCHITECTURE
# ============================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
# Public CRM frontend URL (welcome emails, magic links)
APP_URL=http://localhost:5173
# Optional alias if APP_URL is unset: FRONTEND_URL, PUBLIC_APP_URL
# EMAIL_PRODUCT_NAME=ChiefVoice
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# AUTH - AWS COGNITO
# ============================================================
AUTH_PROVIDER=cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# Needed for the platform admin panel to auto-create Cognito users when
# creating an org (AdminCreateUser/AdminSetUserPassword). Leave unset to use
# the EC2/ECS instance role's IAM credentials instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
PLATFORM_ADMIN_EMAILS=admin@example.com

# ============================================================
# ORACLE MYSQL
# ============================================================
DB_ADAPTER=mysql
MYSQL_POOL_MAX=10
MYSQL_POOL_MIN=0
MYSQL_POOL_IDLE_TIMEOUT_MS=10000
MYSQL_POOL_CONNECTION_TIMEOUT_MS=10000
MYSQL_POOL_QUEUE_LIMIT=50
MYSQL_POOL_MAX_LIFETIME_SECONDS=0
MYSQL_APPLICATION_NAME=chiefvoice-crm-backend
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# MYSQL_URL=mysql://user:password@host:3306/database
MYSQL_TIMEZONE=Z

# ============================================================
# REDIS - CONTAINER ON THE SAME VM
# ============================================================
# When app + redis share a Docker Compose network, use redis as hostname.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=redis://redis:6379

# ============================================================
# OCI QUEUE - MANAGED ORACLE QUEUE
# ============================================================
QUEUE_PROVIDER=memory
OCI_AUTH_MODE=instance_principal
OCI_QUEUE_REGION=ap-hyderabad-1
OCI_QUEUE_OCID=
# Optional per-job-type mapping:
# OCI_QUEUE_MAP=postcall=ocid1.queue.oc1... ,ai_usage=ocid1.queue.oc1...
OCI_QUEUE_MAP=
OCI_QUEUE_ENDPOINT=
OCI_QUEUE_VISIBILITY_SECONDS=300
OCI_QUEUE_POLL_TIMEOUT_SECONDS=20
OCI_QUEUE_POLL_LIMIT=10
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_MS=5000
QUEUE_RETRY_MAX_MS=300000

# Local development alternative for OCI credentials:
# OCI_AUTH_MODE=config_file
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# ============================================================
# SCHEDULER
# ============================================================
# Current VM-safe default. Managed OCI scheduling can call the protected
# /internal/scheduler/:id/run endpoint through an OCI Function.
SCHEDULER_PROVIDER=local
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_TRIGGER_SECRET=
AUTO_DIAL_SCHEDULE=*/15 * * * * *
DIALER_RETRY_SCHEDULE=*/5 * * * * *

# ============================================================
# ORACLE OBJECT STORAGE - S3 COMPATIBILITY API
# ============================================================
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=ap-hyderabad-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_USE_SIGNED_URLS=true
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Optional permanent public base URL; keep empty when using signed URLs.
STORAGE_PUBLIC_URL=

# ============================================================
# CALL RECORDINGS
# ============================================================
RECORDINGS_ENABLED=true
RECORDINGS_PREFIX=recordings/

# ============================================================
# CHROMADB
# ============================================================
CHROMA_URL=http://chroma-db:8000
CHROMA_HOST=chroma-db
CHROMA_PORT=8000

# ============================================================
# GOOGLE VERTEX AI
# ============================================================
GCP_MULTI_PROJECT_ENABLED=true
GOOGLE_CLOUD_LOCATION=us-central1
# Runtime project/credentials are organization-specific and stored in DB.
GCP_RUNTIME_CREDENTIALS_JSON=
GCP_PROJECT_CREDENTIALS_ENCRYPTION_KEY=
GCP_PROJECT_PROVISIONER_CREDENTIALS_JSON=
GCP_BILLING_ACCOUNT_ID=
GCP_PARENT_ORGANIZATION_ID=
GCP_PARENT_FOLDER_ID=
VERTEX_AI_ENABLED=true
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_DEFAULT_MODEL=gemini-2.5-flash
VERTEX_AI_AUDIO_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# ============================================================
# TELECMI / VOICE BRIDGE
# ============================================================
# Python TeleCMI connector running on its own GCP VM.
TELECMI_CONNECTOR_URL=http://127.0.0.1:8080
TELECMI_CONTROL_TOKEN=
TELECMI_WEBHOOK_SECRET=
# Public WSS endpoint exposed by this Chief Voice backend (normally Caddy).
TELECMI_PUBLIC_WS_URL=wss://api.crm.elvoryx.in
TELECMI_STREAM_SECRET=

# ============================================================
# VOBIZ / VOICE
# ============================================================
VOBIZ_ENABLED=true
VOBIZ_BASE_URL=
VOBIZ_WEBHOOK_SECRET=
VOBIZ_STREAM_SECRET=
VOBIZ_STREAM_TOKEN_TTL=300
# live (default): opening uses Gemini Live — same voice as the agent. prepared: faster preview-TTS (different voice).
VOBIZ_OPENING_GREETING_MODE=live
VOICE_WS_ENABLED=true
WS_TICKET_SECRET=
MAX_BROWSER_VOICE_SESSIONS_PER_ORG=5

# ============================================================
# WEBHOOK / INTERNAL SECURITY
# ============================================================
WEBHOOK_SIGNATURE_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE=300
INTERNAL_API_SECRET=
SSE_TICKET_SECRET=
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# ============================================================
# AI RATE LIMITING
# ============================================================
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=60

# ============================================================
# META / WHATSAPP / INSTAGRAM
# ============================================================
META_ENABLED=false
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
INSTAGRAM_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ============================================================
# EMAIL
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# LOGGING / SAFETY
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_SQL=false
LOG_REDACT_SECRETS=true
DEBUG=false
EXPOSE_ERROR_STACK=false
ALLOW_DEV_AUTH=false
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================
# HEALTH
# ============================================================
HEALTH_CHECK_ENABLED=true
READINESS_CHECK_ENABLED=true

# ============================================================
# API GATEWAY - NOT USED CURRENTLY
# ============================================================
API_GATEWAY_ENABLED=false