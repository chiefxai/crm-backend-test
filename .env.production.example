# Backend-only production environment.
# Copy to crm-backend/.env on the VM.
# Never commit the real file.

NODE_ENV=production
PORT=3000
DB_ADAPTER=mysql
# Keep child workspace routing and sharing disabled until full-stack isolation
# verification has passed. Enable each gate deliberately during rollout.
MULTI_WORKSPACE_ENABLED=false
WORKSPACE_ISOLATION_VERIFIED=false
WORKSPACE_SHARING_ENABLED=false
MAX_WORKSPACES_PER_ORG=100

# Public API / CORS
API_DOMAIN=api.crm.elvoryx.in
# Customer-facing CRM app (sign-in links in welcome emails)
APP_URL=https://crm.elvoryx.in
ALLOWED_ORIGINS=https://crm.elvoryx.in

# AWS Cognito authentication
# The frontend authenticates users with Cognito User Pools.
# The backend verifies Cognito JWTs and maps the Cognito subject to the
# application's users/org_members tables in MySQL.
AUTH_PROVIDER=cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_27BqWzy3a
COGNITO_CLIENT_ID=6cs5ghks6nee9uls07te56ajfa
# Optional Cognito Hosted UI domain if the frontend uses OAuth/Hosted UI.
# COGNITO_DOMAIN=chiefvoice-production.auth.ap-south-1.amazoncognito.com
PLATFORM_ADMIN_EMAILS=admin@elvoryx.in

# Amazon RDS for MySQL
DB_ADAPTER=mysql

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=chiefvoice
MYSQL_PASSWORD=17cc6f0c0b733edbd229eafe10e8ed91fcb65738faa483424b4357c93fdf84ca
MYSQL_DATABASE=chiefvoice

MYSQL_POOL_MAX=10
MYSQL_POOL_MIN=0
MYSQL_POOL_IDLE_TIMEOUT_MS=10000
MYSQL_POOL_CONNECTION_TIMEOUT_MS=0
MYSQL_POOL_QUEUE_LIMIT=50
MYSQL_POOL_MAX_LIFETIME_SECONDS=0
MYSQL_APPLICATION_NAME=chiefvoice-crm-backend


# Redis (Docker) - cache/token state
REDIS_URL=redis://redis:6379

# Queue connector
# app and scheduler run as separate containers/processes — the in-process
# "memory" queue does NOT bridge them (each process gets its own isolated
# queue), so autoDialEngine's placeDial jobs (enqueued by scheduler, only
# ever consumed by app) require the durable RabbitMQ connector below.
# SQS support is also implemented but not provisioned for this deployment.
# QUEUE_PROVIDER=aws_sqs
QUEUE_PROVIDER=rabbitmq

# RabbitMQ (Docker) — see docker-compose.yml's `rabbitmq` service and
# src/queue/adapters/rabbitMqQueueAdapter.js. The adapter authenticates
# using ONLY process.env.RABBITMQ_URL (passed straight to amqp.connect) —
# it does not read RABBITMQ_USER/RABBITMQ_PASSWORD itself, so credentials
# MUST be embedded in the URL. RABBITMQ_USER/PASSWORD below exist to (a)
# set the broker container's own login via RABBITMQ_DEFAULT_USER/PASS and
# (b) let docker-compose.yml build a credentialed RABBITMQ_URL from them
# automatically — its default `guest` user only accepts localhost
# connections, which does not work from a separate app/scheduler
# container. Leave RABBITMQ_URL unset here unless you need to point at a
# broker outside this compose stack. Set real values in your actual .env,
# never here.
# RABBITMQ_URL=amqp://change_me:change_me@rabbitmq:5672
RABBITMQ_USER=change_me
RABBITMQ_PASSWORD=change_me
RABBITMQ_EXCHANGE=crm.jobs
RABBITMQ_QUEUE_PREFIX=crm

# Future AWS SQS settings (leave empty until enabled):
AWS_REGION=ap-south-1
AWS_SQS_QUEUE_URL=
AWS_SQS_QUEUE_MAP=
AWS_SQS_WAIT_TIME_SECONDS=20
AWS_SQS_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_MS=5000
QUEUE_RETRY_MAX_MS=300000


# ChromaDB (Docker)
CHROMA_URL=http://chroma-db:8000

# AWS S3
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your-access-key-id
STORAGE_SECRET_KEY=your-secret-access-key
STORAGE_BUCKET=crm-748774319952-ap-south-1-an
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
STORAGE_USE_SIGNED_URLS=true
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Google / Vertex AI runtime identity

GOOGLE_CLOUD_LOCATION=us-central1

# AI / telephony
# Organization-specific call-provider credentials are entered in the platform
# admin organization-creation form and stored in the database.
VOICE_ENGINE=pipeline
GEMINI_API_KEY=
VOBIZ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email / integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=elvoryxinfotech@gmail.com
SMTP_PASS=brfhgyfmdurthmpz
SMTP_FROM="ChiefVoice <elvoryxinfotech@gmail.com>"
RESEND_API_KEY=

# Application security / admin
MAGIC_TOKEN_SECRET=561ed3becfc42abbd54d4798feb57cc028ea243341eedee405dc40edad31e094
# 32-byte key (64 hex chars or base64) used to encrypt per-organization
# Google Cloud service-account credentials stored in organization_cloud_projects.
GCP_PROJECT_CREDENTIALS_ENCRYPTION_KEY=be420d915aa613f766b842b41a6a8c8a0d811aed17c8aa80c4de2bcfbb38c16e

# Event connector
# AWS EventBridge support is implemented but intentionally disabled for now.
# The connector can be enabled later without changing business logic.
AWS_EVENTBRIDGE_BUS_NAME=default
AWS_EVENTBRIDGE_SOURCE=chiefvoice.crm

# Local scheduler for now. Switch to EventBridge Scheduler later:
SCHEDULER_PROVIDER=local
SCHEDULER_TRIGGER_SECRET=6d6b429b83890d75fd45ceac6c5540672c19684964763e5c969f185e2d0eb3b7
LOCAL_AUTH_SECRET=a9427662fe7a108b79fdf5f2338ac39fe80892402eaad8de42e018bfff3e4806

# Webhook/service security
INTERNAL_API_SECRET=a570156434155ec52ff8c9eae7dd0d2cfc46f62abc0aeb362bc1822a065ac6de
SSE_TICKET_SECRET=d7bc15090dfefc27edd26aa3f96a5d367c1360940dbd4e1373fc90a7bd1db7aa
VOBIZ_WEBHOOK_SECRET=fd17a4defaf4a92dd02d0335f18c0c5841ac103e6de66c595abe33ea22d70f42
META_APP_SECRET=0d9dbb8dd14baf1e2a1943c179cf9ab31bc404ae86f40e1d31da8e2f6ecb7bd0
STORAGE_USE_SIGNED_URLS=true

WS_TICKET_SECRET=69d57c73bd9fc44ee1f5446ad2513fe78a0b44540aa82f23e0f8c19731aafe6c
